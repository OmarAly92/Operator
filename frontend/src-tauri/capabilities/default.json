{
	"identifier": "default",
	"description": "Window, menu, theme, and shortcut behavior for the main Operator window",
	"windows": ["main"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"global-shortcut:allow-register",
		"global-shortcut:allow-unregister",
		"allow-window-set-overlay",
		"allow-window-is-fullscreen",
		"allow-theme-set",
		"allow-menu-action",
		"allow-shell-focus",
		"allow-keybindings-apply",
		"allow-keybindings-recording",
		"allow-set-close-shell-terminal-shortcut-enabled",
		"allow-updates-status",
		"allow-updates-check",
		"allow-updates-return-home",
		"allow-updates-download",
		"allow-updates-install",
		"allow-feature-builds-list",
		"allow-feature-builds-active",
		"allow-updates-apply-settings",
		"allow-choose-directory",
		"allow-open-external",
		"allow-clipboard-write",
		"allow-clipboard-read",
		"allow-notification-show",
		"allow-notification-badge",
		"allow-notification-dev-bounce",
		"allow-stage-dropped-file",
		"allow-delete-dropped-file",
		"allow-tray-attention-state",
		"allow-tray-renderer-ready",
		"allow-tray-set-locale",
		"allow-debug-log"
	]
}
