{
	"name": "operator",
	"productName": "Operator",
	"version": "0.10.3",
	"private": true,
	"description": "Tauri + TypeScript frontend for the operator rewrite",
	"author": "Operator",
	"license": "MIT",
	"homepage": "https://github.com/OmarAly92/operator",
	"repository": {
		"type": "git",
		"url": "https://github.com/OmarAly92/operator"
	},
	"scripts": {
		"build:acp-runtime": "node ./scripts/build-acp-runtime.mjs",
		"browser-runtime:prepare": "node ./scripts/prepare-agent-browser.mjs",
		"build:daemon": "node ./scripts/build-daemon.mjs",
		"terminal:build": "npm --prefix ../packages/terminal run build",
		"bench:artifact": "node ./scripts/benchmark-artifact.mjs",
		"bench:shell": "node ./scripts/benchmark-shell.mjs",
		"bench:terminal": "node ./scripts/benchmark-terminal.mjs",
		"check:desktop-parity": "node ./scripts/check-parity-ledger.mjs",
		"dev:tauri": "vite --config vite.renderer.config.ts",
		"dev:web": "VITE_RENDERER_PREVIEW=1 vite --config vite.renderer.config.ts",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"audit:tauri-state": "node ./scripts/audit-tauri-state.mjs",
		"test:tauri-state": "node --test ./scripts/audit-tauri-state.test.mjs",
		"feed:tauri": "node ./scripts/tauri-feed.mjs",
		"package:tauri-mac-zip": "./scripts/package-tauri-mac-zip.sh",
		"verify:tauri-artifacts": "./scripts/verify-tauri-artifacts.sh",
		"tauri:release": "tauri build --config src-tauri/tauri.release.conf.json",
		"typecheck": "tsc --noEmit",
		"pretypecheck": "npm run terminal:build",
		"typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
		"typecheck:e2e-tauri": "tsc --noEmit -p tsconfig.e2e-tauri.json",
		"test:e2e:tauri": "node ./scripts/e2e-tauri-run.mjs",
		"test:e2e-tauri:build-contract": "node ./scripts/e2e-tauri-build-contract.mjs",
		"test:e2e-tauri:build-contract:unit": "node --test ./scripts/e2e-tauri-build-contract.test.mjs",
		"test": "vitest run --config vite.renderer.config.ts",
		"pretest": "npm run terminal:build",
		"test:e2e": "playwright test",
		"test:e2e:renderer": "playwright test --grep \"@T0|@P0\"",
		"api:ts": "openapi-typescript ../backend/internal/httpd/apispec/openapi.yaml -o src/api/schema.ts",
		"predev:tauri": "npm run terminal:build",
		"predev:web": "npm run terminal:build",
		"pretauri:dev": "npm run terminal:build",
		"pretauri:build": "npm run terminal:build",
		"pretauri:release": "npm run terminal:build"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/router-plugin": "^1.168.18",
		"@tauri-apps/cli": "2.11.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/semver": "^7.7.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.2",
		"@wdio/cli": "9.30.0",
		"@wdio/local-runner": "9.30.0",
		"@wdio/mocha-framework": "9.30.0",
		"@wdio/spec-reporter": "9.29.1",
		"@wdio/tauri-service": "1.3.0",
		"app-builder-lib": "^26.15.3",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@operator/terminal-react": "file:../packages/terminal/ts/react",
		"@radix-ui/react-accordion": "^1.2.13",
		"@radix-ui/react-dialog": "^1.1.16",
		"@radix-ui/react-slot": "^1.2.5",
		"@radix-ui/react-tabs": "^1.1.14",
		"@radix-ui/react-tooltip": "^1.2.9",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.15",
		"@tanstack/react-virtual": "^3.14.9",
		"@tauri-apps/api": "2.11.1",
		"@xterm/addon-canvas": "^0.7.0",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-search": "^0.15.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-web-links": "^0.11.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^5.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"i18next": "^26.3.6",
		"lowlight": "^3.3.0",
		"lucide-react": "^1.17.0",
		"motion": "^12.43.0",
		"openapi-fetch": "^0.17.0",
		"posthog-js": "^1.390.2",
		"qrcode.react": "^4.2.0",
		"radix-ui": "^1.5.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.11",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.11.2",
		"remark-gfm": "^4.0.1",
		"semver": "^7.8.5",
		"tailwind-merge": "^3.6.0",
		"ws": "^8.21.1",
		"zustand": "^5.0.14"
	}
}
