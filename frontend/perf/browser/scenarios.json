{
	"system": {
		"kind": "browser",
		"mode": "system",
		"description": "Discovered Chrome/Edge/Chromium drives the full action suite against the local fixture page while the managed probe runs concurrently.",
		"actions": [
			"doctor --json",
			"open {fixture} --json",
			"screenshot {artifacts}/page-system-tab1.png --json",
			"snapshot -i --json",
			"click @e1 --json",
			"console --json",
			"errors --json",
			"cookies set phase0_system_marker system --url {fixture} --json",
			"cookies get --json",
			"tab new {fixture}?tab=system-2 --json",
			"tab list --json",
			"cookies get --json",
			"tab close --json",
			"close --json"
		],
		"timeouts": {
			"doctorMs": 60000,
			"actionMs": 30000
		}
	},
	"managed": {
		"kind": "browser",
		"mode": "managed",
		"description": "Managed engine install, then the same action suite on the isolated managed executable while the system probe runs concurrently.",
		"actions": [
			"doctor --json",
			"install --json",
			"open {fixture} --json",
			"screenshot {artifacts}/page-managed-tab1.png --json",
			"snapshot -i --json",
			"click @e1 --json",
			"console --json",
			"errors --json",
			"cookies set phase0_managed_marker managed --url {fixture} --json",
			"cookies get --json",
			"tab new {fixture}?tab=managed-2 --json",
			"tab list --json",
			"cookies get --json",
			"tab close --json",
			"close --json"
		],
		"timeouts": {
			"doctorMs": 60000,
			"installMs": 600000,
			"actionMs": 30000
		}
	}
}
