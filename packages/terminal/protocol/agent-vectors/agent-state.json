          "detail": ""
        }
      ]
    },
    {
      "name": "payload-filling-the-1024-byte-osc-buffer-ignored",
      "input": "\u001b]777;agent-state;v=1;state=working;\u0007",
      "events": []
    },
    {
      "name": "extension-name-is-case-sensitive",
      "input": "\u001b]777;Agent-State;v=1;state=working\u0007",
      "events": []
    },
    {
      "name": "notify-is-not-an-agent-event",
      "input": "\u001b]777;notify;Build;done\u0007",
      "events": []
    },
    {
      "name": "other-osc-numbers-are-not-agent-events",
      "input": "\u001b]7000;agent-state;v=1;state=working\u0007\u001b]9;agent-state;v=1;state=working\u0007",
      "events": []
    },
    {
      "name": "an-ignored-event-does-not-break-the-next-one",
      "input": "\u001b]777;agent-state;v=9;state=working\u0007\u001b]777;agent-state;v=1;state=idle\u0007",
      "events": [
        {
          "state": "idle",
          "detail": ""
        }
      ]
    }
  ]
