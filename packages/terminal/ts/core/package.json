{
	"name": "@operator/terminal-core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Phase 0 typed-array view over the vt-wasm linear memory.",
	"files": [
		"dist",
		"wasm",
		"assets"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"browser": {
				"types": "./dist/index-browser.d.ts",
				"import": "./dist/index-browser.js"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		}
	},
	"scripts": {
		"prepare:spawn-assets": "node ./scripts/prepare-spawn-assets.mjs",
		"build": "npm run prepare:spawn-assets && tsc -b",
		"prepack": "npm run build",
		"test": "vitest run --config ./vitest.config.ts --passWithNoTests"
	},
	"devDependencies": {
		"jsdom": "29.1.1",
		"typescript": "5.9.3",
		"vitest": "4.1.8"
	}
}
