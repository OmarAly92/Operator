{
	"name": "@operator/terminal-renderer-dom",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Phase 0 one-block DOM renderer that reads typed-array views from @operator/terminal-core.",
	"files": [
		"dist",
		"src/styles.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./src/styles.css"
	},
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run --config ./vitest.config.ts --passWithNoTests"
	},
	"dependencies": {
		"@operator/terminal-core": "file:../core"
	},
	"devDependencies": {
		"jsdom": "29.1.1",
		"typescript": "5.9.3",
		"vitest": "4.1.8"
	}
}
